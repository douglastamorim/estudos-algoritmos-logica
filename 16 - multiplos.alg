algoritmo "Multiplos"

var
      a, b, total: inteiro
      x, y : real
inicio
      Escreval("Digite dois numeros inteiros")
      Leia(a)
      Leia(b)
      
      se (x % y = 0) ou (y % x = 0) entao
         Escreval("Sao multiplos")
      senao
         Escreval("Nao sao multiplos")
      fimse



fimalgoritmo
